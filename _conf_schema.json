{
    "trigger": {
        "description": "总结触发",
        "type": "object",
        "items": {
            "reply_keyword_trigger": {
                "description": "引用+命令触发总结",
                "type": "bool",
                "hint": "引用含视频、图片、文字、图文混合或合并转发的消息并附总结命令即可触发",
                "default": true
            },
            "auto_keywords": {
                "description": "自动总结命令",
                "type": "list",
                "hint": "根据引用内容自动选择口语概述、新闻摘要或笔记总结；适合作为默认总结入口",
                "default": [
                    "总结一下",
                    "总结视频",
                    "自动总结"
                ]
            },
            "oral_keywords": {
                "description": "口语概述命令",
                "type": "list",
                "hint": "强制生成适合群聊快速理解的自然口语概述；旧的“简略总结 / 简单总结”仍兼容到此模式",
                "default": [
                    "口语概述",
                    "口语总结"
                ]
            },
            "news_keywords": {
                "description": "新闻摘要命令",
                "type": "list",
                "hint": "生成类似 BiliNote 新闻卡片的事件背景、经过、身份数据和处置进展",
                "default": [
                    "新闻摘要",
                    "事件摘要",
                    "新闻总结"
                ]
            },
            "note_keywords": {
                "description": "笔记总结命令",
                "type": "list",
                "hint": "生成偏本项目原专业总结的结构化笔记，适合归档和复盘",
                "default": [
                    "笔记总结",
                    "专业总结",
                    "详细总结"
                ]
            }
        }
    },
    "qa": {
        "description": "总结问答",
        "type": "object",
        "hint": "首次总结结果会作为临时知识库；私聊和群聊都通过引用带问答ID的插件总结或问答回复来提问；终止和清理命令可配置",
        "items": {
            "enable": {
                "description": "启用总结问答",
                "type": "bool",
                "default": true
            },
            "exit_commands": {
                "description": "终止问答命令",
                "type": "list",
                "hint": "发送这些命令会结束本轮问答，但不会删除已保存知识库或引用绑定",
                "default": [
                    "结束",
                    "退出"
                ]
            },
            "clear_commands": {
                "description": "清理记忆命令",
                "type": "list",
                "hint": "发送这些命令会删除当前私聊或群聊 scope 下的问答知识库和短对话记忆",
                "default": [
                    "清理",
                    "清空"
                ]
            },
            "record_ttl_minutes": {
                "description": "知识库空闲清理时间（分钟）",
                "type": "int",
                "hint": "按最后检索时间计算；默认 30 分钟未检索就删除，0 表示不自动清理",
                "default": 30
            },
            "history_turns": {
                "description": "短对话记忆轮数",
                "type": "int",
                "hint": "每条总结记录最近 N 轮问答并作为连续追问上下文；默认 5，0 表示不保留问答历史",
                "default": 5
            }
        }
    },
    "llm": {
        "description": "大模型接口",
        "type": "object",
        "items": {
            "provider_source": {
                "description": "大模型提供商",
                "type": "string",
                "options": [
                    "AstrBot 内置提供商",
                    "插件自定义提供商"
                ],
                "hint": "选择使用 AstrBot 已配置的 LLM，或使用本插件独立配置的 LLM 接口",
                "default": "AstrBot 内置提供商"
            },
            "persona": {
                "description": "总结基础人设",
                "type": "object",
                "hint": "控制是否将 AstrBot 已配置的人设叠加到最终总结和问答中",
                "items": {
                    "enable": {
                        "description": "启用基础人设",
                        "type": "bool",
                        "hint": "开启后，最终总结和问答会先叠加下方指定人设的 system prompt；关闭后即使已选择人设也不会使用",
                        "default": false
                    },
                    "persona_id": {
                        "description": "指定人设ID",
                        "type": "string",
                        "hint": "可选择 AstrBot 已配置的人设；如果选择器无法清空，可关闭上方开关停用人设",
                        "_special": "select_persona",
                        "default": ""
                    }
                }
            },
            "astrbot_provider": {
                "description": "AstrBot 内置提供商",
                "type": "object",
                "hint": "当“大模型提供商”选择 AstrBot 内置提供商时生效",
                "items": {
                    "provider_id": {
                        "description": "选择 AstrBot AI",
                        "type": "string",
                        "hint": "点击按钮选择 AstrBot 中已配置的 LLM；留空时尝试使用当前会话正在使用的 LLM",
                        "_special": "select_provider",
                        "default": ""
                    }
                }
            },
            "custom_provider": {
                "description": "自定义提供商",
                "type": "object",
                "hint": "当“大模型提供商”选择插件自定义提供商时生效",
                "items": {
                    "provider": {
                        "description": "厂商/接口类型",
                        "type": "string",
                        "options": [
                            "自定义 OpenAI 兼容",
                            "OpenAI",
                            "Azure OpenAI",
                            "Anthropic Claude",
                            "Google Gemini",
                            "xAI Grok",
                            "Ollama",
                            "DeepSeek",
                            "Moonshot / Kimi",
                            "阿里云百炼 / 通义千问",
                            "智谱 AI / GLM",
                            "火山引擎方舟 / 豆包",
                            "腾讯混元",
                            "百度千帆 / 文心",
                            "Mistral AI",
                            "Groq",
                            "OpenRouter",
                            "SiliconFlow",
                            "Together AI",
                            "Fireworks AI",
                            "DeepInfra"
                        ],
                        "default": "自定义 OpenAI 兼容"
                    },
                    "base_url": {
                        "description": "Base URL",
                        "type": "string",
                        "hint": "预设厂商可留空；自定义 OpenAI 兼容、中转、Azure 或私有部署请填写对应接口地址",
                        "default": ""
                    },
                    "api_key": {
                        "description": "API Key",
                        "type": "string",
                        "default": ""
                    },
                    "model": {
                        "description": "模型",
                        "type": "string",
                        "default": "gpt-5.5"
                    },
                    "api_version": {
                        "description": "API 版本",
                        "type": "string",
                        "hint": "Azure OpenAI 可填写 api-version；其他厂商通常留空",
                        "default": ""
                    }
                }
            }
        }
    },
    "permissions": {
        "description": "权限控制",
        "type": "object",
        "hint": "优先级：管理员 > 个人白名单 > 个人黑名单 > 群组白名单 > 群组黑名单",
        "items": {
            "admin_id": {
                "description": "管理员ID",
                "type": "string",
                "hint": "最高权限，自动加入个人白名单",
                "default": ""
            },
            "whitelist": {
                "description": "白名单",
                "type": "object",
                "hint": "启用但不配置名单会禁止普通用户使用",
                "items": {
                    "enable": {
                        "description": "启用",
                        "type": "bool",
                        "default": false
                    },
                    "user": {
                        "description": "用户ID列表",
                        "type": "list",
                        "default": []
                    },
                    "group": {
                        "description": "群ID列表",
                        "type": "list",
                        "default": []
                    }
                }
            },
            "blacklist": {
                "description": "黑名单",
                "type": "object",
                "items": {
                    "enable": {
                        "description": "启用",
                        "type": "bool",
                        "default": false
                    },
                    "user": {
                        "description": "用户ID列表",
                        "type": "list",
                        "default": []
                    },
                    "group": {
                        "description": "群ID列表",
                        "type": "list",
                        "default": []
                    }
                }
            }
        }
    },
    "基础质量": {
        "description": "核心配置（直接影响最终总结效果）",
        "type": "object",
        "items": {
            "summary": {
                "description": "总结行为",
                "type": "object",
                "items": {
                    "max_completion_tokens": {
                        "description": "总结最大输出长度",
                        "type": "int",
                        "hint": "建议范围：600-4000；太低可能截断，太高可能啰嗦或变慢",
                        "default": 1800
                    },
                    "temperature": {
                        "description": "总结随机性",
                        "type": "float",
                        "hint": "建议范围：0-1；越低越稳定，越高越发散",
                        "default": 0.2
                    },
                    "max_transcript_chars": {
                        "description": "转写输入上限",
                        "type": "int",
                        "hint": "建议范围：4000-60000；越大越能覆盖长视频，但请求更长",
                        "default": 20000
                    }
                }
            },
            "vision": {
                "description": "视觉识别",
                "type": "object",
                "items": {
                    "max_frames": {
                        "description": "每个视频最大抽帧数",
                        "type": "int",
                        "hint": "建议范围：0-32；0 表示不做视觉帧分析",
                        "default": 8
                    },
                    "frame_size": {
                        "description": "视觉帧尺寸",
                        "type": "string",
                        "options": [
                            "512px",
                            "768px",
                            "1024px",
                            "原始尺寸"
                        ],
                        "hint": "原始尺寸保留最多细节，但更慢、更占用额度",
                        "default": "512px"
                    },
                    "image_detail": {
                        "description": "图片细节模式",
                        "type": "string",
                        "options": [
                            "auto",
                            "low",
                            "high"
                        ],
                        "hint": "控制模型理解图片时保留多少视觉细节；low 更快更省，high 更清晰，auto 由模型自动选择",
                        "default": "low"
                    },
                    "batch_size": {
                        "description": "每批图片数量",
                        "type": "int",
                        "hint": "建议范围：1-8；越大单次看图更多，但上下文和请求压力更高",
                        "default": 4
                    }
                }
            }
        }
    },
    "高级质量": {
        "description": "高级配置（更细的质量控制与性能参数）",
        "type": "object",
        "items": {
            "summary": {
                "description": "总结高级参数",
                "type": "object",
                "items": {
                    "max_concurrent": {
                        "description": "总结并发",
                        "type": "int",
                        "hint": "建议范围：1-4；过高可能让多个总结同时占用 LLM 配额",
                        "default": 1
                    },
                    "request_timeout_seconds": {
                        "description": "总结请求超时（秒）",
                        "type": "int",
                        "hint": "建议范围：30-600；过短可能导致长总结失败",
                        "default": 180
                    }
                }
            },
            "vision": {
                "description": "视觉高级参数",
                "type": "object",
                "items": {
                    "max_concurrent": {
                        "description": "视觉识别并发",
                        "type": "int",
                        "hint": "建议范围：1-4；过高可能触发限流或超时",
                        "default": 2
                    },
                    "jpeg_quality": {
                        "description": "视觉帧压缩质量",
                        "type": "int",
                        "hint": "建议范围：2-31；数值越小画质越高，文件也越大",
                        "default": 4
                    },
                    "max_chars": {
                        "description": "视觉观察最大字符数",
                        "type": "int",
                        "hint": "建议范围：1000-20000；越大保留视觉信息越多",
                        "default": 8000
                    },
                    "request_timeout_seconds": {
                        "description": "视觉请求超时（秒）",
                        "type": "int",
                        "hint": "建议范围：30-600；过短可能导致视觉分析失败",
                        "default": 180
                    }
                }
            },
            "asr": {
                "description": "语音转写高级参数",
                "type": "object",
                "items": {
                    "device": {
                        "description": "推理设备",
                        "type": "string",
                        "options": [
                            "cpu",
                            "cuda"
                        ],
                        "hint": "有 GPU 时可改为 cuda",
                        "default": "cpu"
                    },
                    "max_concurrent": {
                        "description": "语音转写并发",
                        "type": "int",
                        "hint": "建议范围：1-2；每个子进程都会加载本地模型，调高前请确认内存充足",
                        "default": 1
                    },
                    "batch_size_s": {
                        "description": "每批转写时长（秒）",
                        "type": "int",
                        "hint": "建议范围：30-600；越大越省批次，越小越省内存",
                        "default": 300
                    },
                    "sample_rate": {
                        "description": "音频采样率",
                        "type": "int",
                        "hint": "建议范围：8000-48000；当前模型最适合 16000",
                        "default": 16000
                    },
                    "asr_timeout_seconds": {
                        "description": "ASR 超时（秒）",
                        "type": "int",
                        "hint": "建议范围：60-3600；长视频可酌情调大",
                        "default": 900
                    }
                }
            }
        }
    },
    "output": {
        "description": "输出控制",
        "type": "object",
        "items": {
            "summary_format": {
                "description": "总结内容格式",
                "type": "string",
                "options": [
                    "纯文本",
                    "Markdown"
                ],
                "hint": "选择 AI 最终总结输出为普通文本或 Markdown；图片发送模式下 Markdown 会渲染为温和浅色卡片",
                "default": "纯文本"
            },
            "send_format": {
                "description": "发送格式",
                "type": "string",
                "options": [
                    "文本",
                    "图片"
                ],
                "hint": "选择最终回复直接发送文本，或生成图片后发送；图片模式使用 Pillow 和插件本地字体绘制温和浅色卡片",
                "default": "文本"
            },
            "qa_answer_format": {
                "description": "问答回答格式",
                "type": "string",
                "options": [
                    "纯文本",
                    "Markdown"
                ],
                "hint": "选择 AI 问答回答输出为普通文本或 Markdown；问答图片发送模式下 Markdown 会渲染为温和浅色卡片",
                "default": "纯文本"
            },
            "qa_send_format": {
                "description": "问答发送格式",
                "type": "string",
                "options": [
                    "文本",
                    "图片"
                ],
                "hint": "选择问答回复直接发送文本，或生成图片后发送；图片模式会把问答ID作为同条消息的文本标记一起发送",
                "default": "文本"
            },
            "image_style": {
                "description": "图片渲染风格",
                "type": "string",
                "options": [
                    "清新",
                    "科技感",
                    "专业严肃",
                    "温和卡片"
                ],
                "hint": "只影响图片视觉，不影响摘要内容模板；清新接近 BiliNote 的粉色便签风格，科技感为深色霓虹风格，专业严肃为白灰蓝商务风格",
                "default": "清新"
            },
            "image_font_family": {
                "description": "图片字体",
                "type": "string",
                "options": [
                    "默认黑体",
                    "专业宋体",
                    "清新文楷",
                    "标题手札",
                    "科技窄体"
                ],
                "hint": "只允许选择插件 resource/font 目录下的内置字体，不读取系统字体或自定义路径；默认黑体适合通用总结，专业宋体更正式，清新文楷更轻松，标题手札适合标题感，科技窄体适合科技风格",
                "default": "默认黑体"
            },
            "image_font_size": {
                "description": "图片字体大小",
                "type": "int",
                "hint": "图片发送模式使用的正文基础字号，建议范围：16-48；标题和小标题会按比例自动放大",
                "default": 25
            },
            "status_message": {
                "description": "发送处理中提示",
                "type": "bool",
                "default": true
            },
            "show_error": {
                "description": "展示总结失败原因",
                "type": "bool",
                "default": true
            },
            "enable_summary_repair": {
                "description": "启用总结格式修复",
                "type": "bool",
                "hint": "默认开启；当模型输出原始转写片段、非标准核对标记或不确定性格式不一致时，会尝试清理并进行一次轻量修复",
                "default": true
            }
        }
    },
    "admin": {
        "description": "管理员调试",
        "type": "object",
        "items": {
            "debug_mode": {
                "description": "调试日志",
                "type": "bool",
                "hint": "打开后会输出触发判断、候选提取、下载、ASR、视觉判定、视觉分析、LLM 调用、格式修复和清理等阶段日志，便于维护者排查问题",
                "default": false
            },
            "test_keyword": {
                "description": "管理员测试命令关键词",
                "type": "string",
                "hint": "仅 permissions.admin_id 对应账号在私聊中发送该关键词时触发 AI 连通性测试，不会触发内容总结",
                "default": "aiping"
            }
        }
    }
}
